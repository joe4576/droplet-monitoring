{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "droplet-monitoring",
  "main": "worker/index.ts",
  // Latest date supported by the workerd runtime bundled with this Wrangler release.
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "secrets": {
    "required": ["DIGITALOCEAN_API_TOKEN", "DROPLET_IDS", "AUTH_API_KEY"],
  },
  "d1_databases": [
    {
      "binding": "SESSIONS_DB",
      "database_name": "droplet-monitoring-sessions",
      "migrations_dir": "migrations",
      "database_id": "49817ef1-057b-48e9-9e1a-3b7f280e1cd0",
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
}
